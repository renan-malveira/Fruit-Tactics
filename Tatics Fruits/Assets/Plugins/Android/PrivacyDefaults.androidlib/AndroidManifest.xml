<?xml version="1.0" encoding="utf-8"?>
<!-- Fruit Tactics: privacy defaults.
     Firebase Analytics starts disabled and is enabled at runtime by ConsentManager
     (FirebaseAnalytics.SetAnalyticsCollectionEnabled) once the player has consented. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.suricatus.fruittactics.privacydefaults">

    <application>
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
    </application>
</manifest>
